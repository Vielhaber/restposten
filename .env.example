# Copy to .env and fill in. Never commit the real .env file.

# --- Database (Postgres — works with plain Postgres or Supabase Postgres) ---
DATABASE_URL="postgresql://user:password@localhost:5432/restposten?schema=public"

# --- NextAuth.js (Auth.js v5) ---
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# --- EU VIES VAT verification (see src/lib/services/vies.service.ts) ---
VIES_API_BASE_URL="https://ec.europa.eu/taxation_customs/vies/rest-api"
# Set to "true" locally to hit the EU's test fixture endpoint instead of production.
VIES_USE_TEST_SERVICE="false"
VIES_REQUEST_TIMEOUT_MS="10000"
VIES_MAX_CONCURRENT_REQUESTS="4"
VIES_CACHE_TTL_MS="3600000"

# --- Stripe Connect (Phase 2) ---
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_CLIENT_ID=""

# --- Pusher (Phase 2/3 — real-time Dutch Auction price updates) ---
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="eu"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="eu"
